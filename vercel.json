    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/receipt", "destination": "/receipt.html" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/availability", "destination": "/availability.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" }
  ]
}
